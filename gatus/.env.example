# 复制成 .env 并 chmod 600。值都不进 git。
# 面板 admin 密码的 bcrypt（cost 9）再 base64；明文只在 Bitwarden「status.xanne.cloud」
GATUS_ADMIN_PASSWORD_BCRYPT_B64=
# 同 agent-vault comm/FEISHU_WEBHOOK_PRAXIS_PATROL
FEISHU_WEBHOOK_PRAXIS_PATROL=
# 心跳 token，现场 `openssl rand -hex 24` 生成；同值另存在各上报方的 .env
GATUS_PUSH_TOKEN_OKX_WATCHDOG=
GATUS_PUSH_TOKEN_DAILY_LOG=
GATUS_PUSH_TOKEN_QD_CHECKIN=
