# 复制为 .env（chmod 600），值从 agent-vault 取，见 README「生成 .env」。不要把 .env 提交进 git。
ZITADEL_VERSION=v4.19.5
ZITADEL_DOMAIN=id.xanne.cloud

# --- 秘密：agent-vault infra vault ---
ZITADEL_MASTERKEY=            # infra/ZITADEL_MASTERKEY，恰好 32 字符；丢失 = 实例不可恢复
ZITADEL_LOGIN_COOKIE_SECRET=  # infra/ZITADEL_LOGIN_COOKIE_SECRET
ZITADEL_DB_PASSWORD=          # infra/ZITADEL_DB_PASSWORD（只含 DSN 安全字符）
ZITADEL_ADMIN_PASSWORD=       # infra/ZITADEL_ADMIN_PASSWORD，须含大小写、数字、符号；首登强制改密
RESEND_API_KEY=               # infra/RESEND_API_KEY

# --- 非秘密 ---
ZITADEL_ADMIN_USERNAME=admin
ZITADEL_ADMIN_EMAIL=
SMTP_FROM=no-reply@xanne.cloud
LOGIN_CLIENT_PAT_EXPIRATION=2099-01-01T00:00:00Z
ADMIN_PAT_EXPIRATION=2027-10-20T00:00:00Z
